---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by year for timeline-style listing
const postsByYear = posts.reduce(
  (acc, post) => {
    const year = post.data.pubDate.getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof posts>,
);

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div class="site-container">
      <Header />

      <main>
        <!-- ── Site intro ──────────────────────── -->
        <section class="site-intro">
          <h1 class="intro-headline">
            Writing on systems,<br />technology &amp; ideas.
          </h1>
        </section>

        <!-- ── Post list ───────────────────────── -->
        <div class="post-list">
          {years.map((year) => (
            <div class="year-group">
              <div class="year-marker">
                <span class="year-label">{year}</span>
              </div>
              <ul role="list" class="year-posts">
                {postsByYear[year].map((post) => (
                  <li class="post-item">
                    <a href={`/blog/${post.id}/`} class="post-row">
                      <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                        <FormattedDate date={post.data.pubDate} />
                      </time>
                      <div class="post-body">
                        <span class="post-title">{post.data.title}</span>
                        {post.data.description && (
                          <span class="post-desc">{post.data.description}</span>
                        )}
                      </div>
                      <span class="post-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </main>

      <Footer />
    </div>
  </body>
</html>

<style>
  /* ── Site intro ───────────────────────────── */
  .site-intro {
    padding: 3.5rem 2.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .intro-headline {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
  }

  /* ── Post list ────────────────────────────── */
  .post-list {
    display: flex;
    flex-direction: column;
  }

  /* ── Year group ───────────────────────────── */
  .year-group {
    display: grid;
    grid-template-columns: 6rem 1fr;
    border-bottom: 1px solid var(--hairline);
  }

  .year-marker {
    padding: 2rem 0 2rem 2.5rem;
    border-right: 1px solid var(--hairline);
    display: flex;
    align-items: flex-start;
    position: sticky;
    top: 0;
  }

  .year-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
    writing-mode: horizontal-tb;
  }

  .year-posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Individual post row ──────────────────── */
  .post-item {
    border-bottom: 1px solid var(--hairline);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-row {
    display: grid;
    grid-template-columns: 8rem 1fr 2rem;
    align-items: start;
    gap: 1.25rem;
    padding: 1.5rem 2rem 1.5rem 2rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.12s ease;
    position: relative;
  }

  .post-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--coral);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease;
  }

  .post-row:hover {
    background-color: var(--soft-stone);
  }

  .post-row:hover::before {
    transform: scaleY(1);
  }

  .post-date {
    font-size: 0.775rem;
    color: var(--muted);
    font-weight: 500;
    padding-top: 0.225rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.35;
    transition: color 0.12s;
  }

  .post-row:hover .post-title {
    color: var(--primary);
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--body-muted);
    line-height: 1.55;
  }

  .post-arrow {
    font-size: 0.9rem;
    color: var(--hairline);
    align-self: center;
    justify-self: end;
    transition: color 0.12s, transform 0.15s ease;
  }

  .post-row:hover .post-arrow {
    color: var(--coral);
    transform: translateX(4px);
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 768px) {
    .site-intro {
      padding: 2.5rem 1.5rem;
    }

    .year-group {
      grid-template-columns: 1fr;
    }

    .year-marker {
      padding: 1rem 1.5rem 0.5rem;
      border-right: none;
      border-bottom: 1px solid var(--hairline);
      position: static;
    }

    .post-row {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      padding: 1.25rem 1.5rem;
      gap: 0.25rem 1rem;
    }

    .post-date {
      grid-column: 1;
      grid-row: 1;
    }

    .post-body {
      grid-column: 1;
      grid-row: 2;
    }

    .post-arrow {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }
  }

  @media (max-width: 480px) {
    .site-intro {
      padding: 2rem 1rem;
    }

    .year-marker {
      padding: 1rem;
    }

    .post-row {
      padding: 1.25rem 1rem;
    }
  }
</style>
